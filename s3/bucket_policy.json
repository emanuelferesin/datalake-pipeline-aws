{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PermitirListPorPrefijo",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::000000000000:role/batch-role"},
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::datalake-ventas",
      "Condition": {"StringLike": {"s3:prefix": ["raw/*", "processed/*", "curated/*"]}}
    },
    {
      "Sid": "PermitirLecturaRawProcessedCurated",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::000000000000:role/batch-role"},
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::datalake-ventas/raw/*",
        "arn:aws:s3:::datalake-ventas/processed/*",
        "arn:aws:s3:::datalake-ventas/curated/*"
      ]
    },
    {
      "Sid": "PermitirEscrituraProcessedCurated",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::000000000000:role/batch-role"},
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::datalake-ventas/processed/*",
        "arn:aws:s3:::datalake-ventas/curated/*"
      ]
    }
  ]
}